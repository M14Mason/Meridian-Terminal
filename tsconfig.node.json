{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "tests",
    "worker/src/**/*.test.ts",
    "worker/src/test-sql.ts",
    "shared/**/*.test.ts"
  ]
}