{
  "name": "meridian-terminal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run scan:secrets",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "hooks:install": "git config core.hooksPath .githooks",
    "supply:universe": "node scripts/supply/universe.mjs",
    "supply:prep": "esbuild scripts/supply/prep.mjs --bundle --platform=node --format=esm --outfile=.cache/supply-prep.mjs --log-level=warning && node .cache/supply-prep.mjs",
    "supply:save": "esbuild scripts/supply/save.mjs --bundle --platform=node --format=esm --outfile=.cache/supply-save.mjs --log-level=warning && node .cache/supply-save.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lightweight-charts": "5.2.1",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
